{
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**"
    ],
    "rewrites": [
      {
        "source": "/api/neis",
        "function": {
          "functionId": "neis",
          "region": "asia-northeast3"
        }
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}